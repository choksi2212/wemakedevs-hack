# FalkorDB (the load-bearing engine)
SEVER_FALKOR_HOST=127.0.0.1
SEVER_FALKOR_PORT=6379

# Optional LLM narration — ANY OpenAI-compatible endpoint works
# (unset -> NullLLM offline fallback; the product runs fully without it)
SEVER_LLM_BASE_URL=
SEVER_LLM_API_KEY=
SEVER_LLM_MODEL=

# BloodHound CE sample data (Apache-2.0, SpecterOps):
# https://raw.githubusercontent.com/SpecterOps/BloodHound-Docs/main/docs/assets/sample-data/ad_sampledata.zip
SEVER_SAMPLE_DIR=./data/ad_sample

# AzureHound sample for the hybrid Entra beat (same SpecterOps sample set):
# https://raw.githubusercontent.com/SpecterOps/BloodHound-Docs/main/docs/assets/sample-data/entra_sampledata.zip
SEVER_ENTRA_FILE=./data/entra_sample/azurehound_example.json
