# Every SEVER env var the code reads (os.environ across sever/ + scripts/).
# A .env file at the repo root is loaded automatically by the console and the
# live script/eval entry points; variables already set in the real
# environment always win.

# FalkorDB (the load-bearing engine)
SEVER_FALKOR_HOST=127.0.0.1
SEVER_FALKOR_PORT=6379
# Optional credentials — only for authenticated endpoints (e.g. FalkorDB
# Cloud); unset for the plain `docker compose up -d` demo, which has no auth.
SEVER_FALKOR_USER=
SEVER_FALKOR_PASSWORD=
# Graph keys (FalkorDB native multi-tenancy): the console's tenant, and the
# eval ablation's scratch graph (ablation deletes it after the run).
SEVER_FALKOR_GRAPH=sever_demo
SEVER_EVAL_GRAPH=sever_eval

# Optional LLM narration — ANY OpenAI-compatible endpoint works
# (unset -> NullLLM offline fallback; the product runs fully without it)
SEVER_LLM_BASE_URL=
SEVER_LLM_API_KEY=
SEVER_LLM_MODEL=

# Console docs (FastAPI /docs, /redoc, /openapi.json). Off by default: on a
# public deployment the rendered schema is attacker recon. Set to 1 to enable
# during development.
SEVER_DOCS=

# BloodHound CE sample data (Apache-2.0, SpecterOps):
# https://raw.githubusercontent.com/SpecterOps/BloodHound-Docs/main/docs/assets/sample-data/ad_sampledata.zip
SEVER_SAMPLE_DIR=./data/ad_sample

# AzureHound sample for the hybrid Entra beat (same SpecterOps sample set):
# https://raw.githubusercontent.com/SpecterOps/BloodHound-Docs/main/docs/assets/sample-data/entra_sampledata.zip
SEVER_ENTRA_FILE=./data/entra_sample/azurehound_example.json
