# Every SEVER env var the code reads (os.environ across sever/ + scripts/,
# plus the test-harness knobs at the bottom). A .env file at the repo root is
# loaded automatically by the console and the live script/eval entry points;
# variables already set in the real environment always win.

# FalkorDB (the load-bearing engine)
SEVER_FALKOR_HOST=127.0.0.1
SEVER_FALKOR_PORT=6379
# Optional credentials — only for authenticated endpoints (e.g. FalkorDB
# Cloud); unset for the plain `docker compose up -d` demo, which has no auth.
SEVER_FALKOR_USER=
SEVER_FALKOR_PASSWORD=
# Socket timeouts bound engine HANGS, not query time: without them redis-py
# waits forever on a stalled remote engine. A stalled query fails as a clean
# ConnectionError (console answers 503 JSON) within SEVER_FALKOR_SOCKET_TIMEOUT
# seconds; SEVER_FALKOR_CONNECT_TIMEOUT bounds the TCP connect itself.
SEVER_FALKOR_SOCKET_TIMEOUT=30
SEVER_FALKOR_CONNECT_TIMEOUT=10
# Graph keys (FalkorDB native multi-tenancy): the console's tenant, and the
# eval ablation's scratch graph (ablation deletes it after the run).
SEVER_FALKOR_GRAPH=sever_demo
SEVER_EVAL_GRAPH=sever_eval
# Bounded staleness window (ms) for the read-side snapshot cache — covers
# out-of-band reloads and OTHER processes' mutations. 0 disables the folds
# entirely (exactly the legacy per-query sequence). Reachability itself is
# never cached.
SEVER_FALKOR_SNAPSHOT_TTL_MS=2000

# Optional LLM narration — ANY OpenAI-compatible endpoint works
# (unset -> the OfflineNarrator deterministic offline fallback in
# sever/agent/llm.py; the product runs fully without it)
SEVER_LLM_BASE_URL=
SEVER_LLM_API_KEY=
SEVER_LLM_MODEL=

# Console docs (FastAPI /docs, /redoc, /openapi.json). Off by default: on a
# public deployment the rendered schema is attacker recon. Set to 1 to enable
# during development.
SEVER_DOCS=

# Console boot: set to 1 ONLY for engine-free test imports — the module-level
# app is skipped and the test builds one with an injected port. Production
# (uvicorn) never sets this and always bootstraps.
SEVER_CONSOLE_NO_BOOTSTRAP=

# Dead config: SEVER_BACKEND is declared in render.yaml (generateValue:
# false, kept unset on purpose) but NOTHING in this repo reads it — no
# sever/ or scripts/ code path consumes it. Documented here only so the
# deploy-dashboard key is explained; do not expect setting it to do anything.
SEVER_BACKEND=

# BloodHound CE sample data (Apache-2.0, SpecterOps):
# https://raw.githubusercontent.com/SpecterOps/BloodHound-Docs/main/docs/assets/sample-data/ad_sampledata.zip
SEVER_SAMPLE_DIR=./data/ad_sample

# AzureHound sample for the hybrid Entra beat (same SpecterOps sample set):
# https://raw.githubusercontent.com/SpecterOps/BloodHound-Docs/main/docs/assets/sample-data/entra_sampledata.zip
SEVER_ENTRA_FILE=./data/entra_sample/azurehound_example.json

# --- Test / audit-harness knobs (not part of the running product) ---
# Prefix applied to engine graph keys by tests/conftest.py so a shared engine
# can run parallel CI fleets without key collisions; empty = no prefix.
SEVER_TEST_GRAPH_PREFIX=
# Port for the isolated uvicorn console spawned by tests/test_console_e2e.py.
SEVER_E2E_PORT=8165
# Receipt output directory override for tests/test_perf_equivalence.py
# (unset -> the test's default location).
SEVER_PERF_RECEIPT_DIR=
# Target console URL for the audit5 live API matrix script
# (scripts/audit5_api_matrix/live_matrix.py); default is the live deployment.
SEVER_AUDIT_BASE=https://sever-console.onrender.com
